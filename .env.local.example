# Copy to .env.local and fill in real values. Never commit .env.local.
# See spec.md §E (Dependencies & Assumptions) and plan.md §D (Constraints).

# Supabase (Postgres) — runtime source of truth for Korean name mappings
# and the synced player-data table (REQ-KOREAN-001/005, REQ-SYNC-003).
#
# SUPABASE_ANON_KEY: the public/anon key. Subject to Row Level Security
# (RLS) — the `players` table grants `anon` a public SELECT-only policy, no
# write access. For future live-gameplay read consumers (M6/M7/M2).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ANON_KEY=

# SUPABASE_SERVICE_ROLE_KEY: the service_role secret, found in your Supabase
# project's Dashboard → Project Settings → API → Project API keys →
# service_role. This key BYPASSES Row Level Security entirely. It is used
# ONLY by the M4 player-data sync job (lib/player-data-sync/,
# scripts/sync-players.ts) to write the `players` table, since RLS grants
# `anon` no write policy (supabase/migrations/0001_create_players_table.sql).
# MUST NEVER be prefixed `NEXT_PUBLIC_` or referenced from client-shipped
# code or a live gameplay request handler — treat it with at least the same
# protection level as FOOTBALL_DATA_API_KEY below (REQ-NFR-001).
SUPABASE_SERVICE_ROLE_KEY=

# football-data.org API key. Server-side only — accessed exclusively by the
# periodic sync job (lib/player-data-sync/). MUST NEVER be referenced from
# client-shipped code or a live gameplay request handler (REQ-NFR-001,
# REQ-SYNC-001).
FOOTBALL_DATA_API_KEY=
